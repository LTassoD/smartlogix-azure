# Copy this file to .env for Docker Compose. Never commit the populated .env file.
SMARTLOGIX_DB_USERNAME=smartlogix
SMARTLOGIX_DB_PASSWORD=
SMARTLOGIX_RABBITMQ_USERNAME=smartlogix
SMARTLOGIX_RABBITMQ_PASSWORD=
SMARTLOGIX_PGADMIN_EMAIL=admin@smartlogix.cl
SMARTLOGIX_PGADMIN_PASSWORD=

# Docker Compose supplies these values to the Java service containers.
SMARTLOGIX_JWT_SECRET=
SMARTLOGIX_JWT_ISSUER=smartlogix-identity-service
SMARTLOGIX_2FA_ENCRYPTION_PASSWORD=
SMARTLOGIX_2FA_ENCRYPTION_SALT=

# Fresh demo database only. Seeding stays disabled unless explicitly enabled.
SMARTLOGIX_SEED_ENABLED=false
SMARTLOGIX_SEED_ADMIN_PASSWORD=
SMARTLOGIX_SEED_OPERATOR_PASSWORD=
SMARTLOGIX_SEED_VIEWER_PASSWORD=
